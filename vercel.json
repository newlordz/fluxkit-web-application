{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{data,server,shared}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/google",
      "destination": "/api/auth?action=google"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?action=login"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth?action=register"
    },
    {
      "source": "/api/auth/password",
      "destination": "/api/auth?action=password"
    },
    {
      "source": "/api/auth/reset-request",
      "destination": "/api/auth?action=reset-request"
    },
    {
      "source": "/api/auth/reset-confirm",
      "destination": "/api/auth?action=reset-confirm"
    },
    {
      "source": "/api/auth/session",
      "destination": "/api/auth?action=session"
    },
    {
      "source": "/api/db/admin",
      "destination": "/api/db?action=admin"
    },
    {
      "source": "/api/db/apis",
      "destination": "/api/db?action=apis"
    },
    {
      "source": "/api/db/gateways",
      "destination": "/api/db?action=gateways"
    },
    {
      "source": "/api/db/status",
      "destination": "/api/db?action=status"
    },
    {
      "source": "/api/db/users",
      "destination": "/api/db?action=users"
    },
    {
      "source": "/api/adobe-pdf/(.*)",
      "destination": "/api/adobe-pdf?action=$1"
    },
    {
      "source": "/api/ilovepdf/(.*)",
      "destination": "/api/ilovepdf?action=$1"
    },
    {
      "source": "/api/ocr-space/(.*)",
      "destination": "/api/ocr-space?action=$1"
    },
    {
      "source": "/api/image-table/extract",
      "destination": "/api/image-table?action=extract"
    },
    {
      "source": "/api/paystack/verify-keys",
      "destination": "/api/paystack/verify-keys"
    },
    {
      "source": "/api/paystack/(.*)",
      "destination": "/api/paystack?action=$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
