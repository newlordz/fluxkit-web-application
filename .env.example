# Optional public backend endpoint (for example /api).
# Audio to Text requires /transcription/capabilities and /transcription/jobs.
# Leave empty for explicit "Backend not connected" local selection mode.
# Never add provider credentials; keep those in the backend adapter only.
VITE_API_BASE_URL=

# Server-only. Used by the optional cloud assist in Image to Excel.
# The browser never receives this key.
GEMINI_API_KEY=
# Maximum Gemini request attempts per UTC day; raise only with paid capacity.
GEMINI_DAILY_REQUEST_LIMIT=40
GEMINI_USER_DAILY_REQUEST_LIMIT=9

# Signed-out Word to PDF conversions per visitor (keyed address hash) per UTC day.
# The shared monthly iLovePDF quota still caps total spend across all visitors.
ILOVEPDF_ANONYMOUS_DAILY_LIMIT=3

# Optional. Set to false to disable anonymous funnel events and quick feedback.
# Events contain only a random visit ID, tool ID, funnel stage, and sequence.
VITE_ENABLE_PRODUCT_INSIGHTS=true

# Google sign-in. Both values must use the same Web application OAuth client ID.
# The VITE value is public; no client secret is required by this access-token flow.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Server-only password recovery delivery. Recovery stays disabled until both are set.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

# Optional additional trusted browser origin for cross-origin API requests.
APP_ORIGIN=

# File Transfer pairing. Defaults to the keyless PeerJS cloud service.
# For production control, these may point to your own compatible PeerJS server.
# If you change the host or TURN endpoint origin, also allow it in index.html connect-src.
VITE_PEER_HOST=0.peerjs.com
VITE_PEER_PORT=443
VITE_PEER_PATH=/
VITE_PEER_SECURE=true
VITE_PEER_KEY=peerjs

# Optional private TURN. Prefer an HTTPS endpoint that returns short-lived
# RTCIceServer credentials. Never put a long-lived TURN secret in a VITE value.
# When these are empty, File Transfer uses STUN plus the disclosed community
# Open Relay fallback for restrictive networks.
VITE_TURN_CREDENTIALS_URL=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
